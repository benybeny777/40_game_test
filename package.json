{
  "name": "taskbar-hyakkiko",
  "version": "0.0.0",
  "private": true,
  "description": "タスクバー百鬼行 M1",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node tools/dev.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:shell": "node tools/shell-check.mjs",
    "sim": "node --experimental-strip-types tools/sim-runner.ts",
    "build": "electron-vite build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.18",
    "@types/node": "24.19.2",
    "electron": "44.9.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@swc/core", "electron", "esbuild"]
  }
}
